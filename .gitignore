# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

certificates

# onnxruntime-web wasm binaries, copied out of node_modules by the postinstall script
# (14MB, and they must always match the installed package version)
/public/onnx/

# design reference mockups, not part of the app
/public/mockups/

# data tooling, not part of the app: DB migrations, one-off scripts (mosaic atlas, species matching,
# area seeding, fun-fact generator) and everything they download or export
/migrations/
/scripts/
.cache/
/docs/fun-facts-review.md
